# Installed to /etc/default/vertex-agent. Per-host, so it is the one file that
# differs between Pis.
VERTEX_USER=plant123
VERTEX_REPO=/home/plant123/Desktop/vertex-testbed
VERTEX_DATA=/home/plant123/vertex-data
# Absolute path. A systemd unit inherits no shell, so an activated venv is
# invisible to it; name the venv's interpreter here to use one.
#   VERTEX_PYTHON=/home/plant123/Desktop/vertex-testbed/.venv/bin/python3
VERTEX_PYTHON=/usr/bin/python3
VERTEX_IFACE=wlan0
VERTEX_SERIAL=/dev/ttyACM0
