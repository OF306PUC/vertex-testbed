# ─────────────────────────────────────────────────────────────────────────────
# Generated, machine-local, or reproducible. Nothing here is part of the
# testbed; all of it comes back from a build, a test run, or an experiment.
#
# Note on what is deliberately NOT here: `tests/` and `*/firmware/tests/` are
# source. The Python suite (pyproject: testpaths) and the host C tests for the
# Zephyr-free units both live in directories named `tests`.
# ─────────────────────────────────────────────────────────────────────────────


# ── Zephyr / CMake / west ────────────────────────────────────────────────────
# `build/` under firmware/nordic and each test/*/firmware. 25 MB per board of
# object files, generated devicetree, and .config -- regenerated by west build.
build/
build-*/
twister-out/
twister-out.*/
.west/

# ── host C tests ─────────────────────────────────────────────────────────────
# `make -C tests` links these two binaries next to their sources. They have no
# extension, so they are named rather than globbed.
test_proto
test_agent
*.o
*.obj
*.elf
*.hex
*.map

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── virtualenvs ──────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── run output ───────────────────────────────────────────────────────────────
# runlog writes <dir>/<run>/<node_id>.{bin,csv,jsonl}. Capture data belongs in
# the run archive, not in the repo -- committed data that looks like a result
# is worse than no data, because it is impossible to tell which build made it.
runs/
out/
results/

# ── editor / OS ──────────────────────────────────────────────────────────────
# .vscode/settings.json is kept: it registers the nRF Connect application path
# so the extension finds the firmware without per-machine setup.
.vscode/*
!.vscode/settings.json
*.swp
*~
.DS_Store
